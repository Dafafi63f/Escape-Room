# --- Generado al jugar (informes y feedback) ---
Juego/Informes/*
!Juego/Informes/.gitkeep
!Juego/Informes/README.md
Juego/Feedback/*
!Juego/Feedback/.gitkeep
!Juego/Feedback/README.md

# --- Local del creador (secretos y .exe; no versionar) ---
Data/creador_privado.json
Juego/juego_cuestionario.exe

# --- Temporales (limpiar con borrar_temporales.py) ---
__pycache__/
*.txt

# --- Revisión del tutor (PDF con comentarios; local) ---
Revision/*
!Revision/.gitkeep
!Revision/*.md

# --- Compilación LaTeX (si compilas Memoria/Memoria_TFG.tex a mano) ---
Entrega/Memoria/*.aux
Entrega/Memoria/*.log
Entrega/Memoria/*.out
Entrega/Memoria/*.toc
Entrega/Memoria/*.fls
Entrega/Memoria/*.fdb_latexmk
Entrega/Memoria/*.synctex.gz
